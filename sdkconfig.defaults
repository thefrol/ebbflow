# Общие дефолты для обеих целей.
# Цель выбирается командой: idf.py set-target esp32c3 (или esp32c6)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Своя разметка флеша (partitions.csv): два OTA-слота по ~1.9M без factory.
# Штатная two_ota держит ещё factory 1M, и слоты 1M тесны для TLS+OTA.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Плата подключена по нативному USB (без UART-моста): консоль выводим
# в USB Serial/JTAG, иначе логов в usbmodem не видно.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Оптимизация по размеру: с TLS и OTA прошивка упирается в слот 1 МБ
# при дефолтном -Og. С -Os влезает с большим запасом.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# Откат при неудачной загрузке OTA-образа: новая прошивка должна сама
# подтвердить работоспособность (esp_ota_mark_app_valid_cancel_rollback
# в main.c после подключения к Wi-Fi), иначе загрузчик вернёт предыдущую.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Общий mDNS-домен флота: все лампы отвечают на ebbflow.local,
# страница любой из них показывает весь флот.
CONFIG_LAMP_FLEET_HOSTNAME="ebbflow"
